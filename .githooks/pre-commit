#!/bin/sh
# EKOS Library pre-commit hook. Enabled by: git config core.hooksPath .githooks
ROOT="$(git rev-parse --show-toplevel)"
PY="${LIBRARY_PYTHON:-$ROOT/09_Server/.venv/Scripts/python.exe}"
[ -x "$PY" ] || PY="$ROOT/09_Server/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3 || command -v python)"
exec "$PY" "$ROOT/09_Server/hookcheck.py"
